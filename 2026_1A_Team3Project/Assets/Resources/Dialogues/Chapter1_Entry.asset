%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b7d8a690fa834739a393e1d62072b901, type: 3}
  m_Name: Chapter1_Entry
  m_EditorClassIdentifier: 
  characterName: "\uB9C8\uCE74\uB871"
  characterImage: {fileID: 21300000, guid: eb879457fcc3a344b907bbfca84a4b72, type: 3}
  useDefaultBackground: 1
  defaultBackgroundImage: {fileID: 0}
  defaultBackgroundColor: {r: 0, g: 0, b: 0, a: 1}
  entries:
  - text: "\uD55C\uBC24\uC911. \uC624\uB798\uB41C \uACFC\uC790 \uACF5\uBC29 \uC548."
    characterName: 
    characterImage: {fileID: 0}
    changeBackground: 1
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 1}
  - text: "\uB9C8\uCE74\uB871 \uB9C8\uB140\uB294 \uC774\uBD88 \uC18D\uC5D0\uC11C
      \uC544\uC8FC \uD488\uACA9 \uC788\uB294 \uC7A0\uC744 \uC990\uAE30\uACE0 \uC788\uC5C8\uB2E4."
    characterName: 
    characterImage: {fileID: 0}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 1}
  - text: "\uCF85! \uCF85! \uC640\uC544\uC544\uC544!"
    characterName: 
    characterImage: {fileID: 0}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 1}
  - text: "\uC73C\uC73C\uC751... \uC2DC\uB044\uB7EC\uC6CC!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 23c865355679f424d93d64ffdb23ee04, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 1}
  - text: "\uC5B4\uB5A4 \uBC84\uB974\uC7A5\uBA38\uB9AC \uC5C6\uB294 \uAC83\uC774\uB0D0!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 0670a9cd0bb4cbd4d81d887410af3768, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 1}
  - text: "\uBCF8 \uB9C8\uB140\uC758 \uB0AE\uC7A0... \uC544\uB2C8, \uD488\uACA9 \uC788\uB294
      \uC218\uBA74\uC744 \uBC29\uD574\uD558\uB2E4\uB2C8!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 0670a9cd0bb4cbd4d81d887410af3768, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 1}
  - text: "\uB9C8\uCE74\uB871\uC740 \uC529\uC529\uAC70\uB9AC\uBA70 \uBC00\uB300\uB97C
      \uB4E4\uACE0 \uBB38\uBC16\uC73C\uB85C \uB098\uC130\uB2E4."
    characterName: 
    characterImage: {fileID: 0}
    changeBackground: 1
    backgroundImage: {fileID: 21300000, guid: 02614b71540849d4394c718704d17dba, type: 3}
    backgroundColor: {r: 1, g: 1, b: 1, a: 1}
  - text: "\uBAA8\uB450 \uC8FC\uBAA9!"
    characterName: "\uB450\uCAC0\uCFE0"
    characterImage: {fileID: 21300000, guid: 8ba5062473f75fd4ba6f6629a2fb65f0, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC624\uB298\uC758 \uC8FC\uC778\uACF5, \uB450\uBC14\uC774 \uCAC0\uB4DD
      \uCFE0\uD0A4 \uB4F1\uC7A5\uC774\uC57C!"
    characterName: "\uB450\uCAC0\uCFE0"
    characterImage: {fileID: 21300000, guid: 52fd380f94db54d45a90b857eeb2570f, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC88B\uC544\uC694\uB791 \uD314\uB85C\uC6B0 \uAFB9\uAFB9 \uBD80\uD0C1!"
    characterName: "\uB450\uCAC0\uCFE0"
    characterImage: {fileID: 21300000, guid: 52fd380f94db54d45a90b857eeb2570f, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uB450\uBC14\uC774..."
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: eb879457fcc3a344b907bbfca84a4b72, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uCAC0\uB4DD..."
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 23c865355679f424d93d64ffdb23ee04, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uCFE0\uD0A4?"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 0670a9cd0bb4cbd4d81d887410af3768, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC774\uB984\uBD80\uD130 \uC815\uC2E0 \uC0AC\uB0A9\uAD6C\uB098!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 0670a9cd0bb4cbd4d81d887410af3768, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC55E\uC5D0 \uB2EC\uB9B0 \uBBF8\uC0AC\uC5EC\uAD6C\uB294 \uBB50\uB354\uB0D0?
      \uB09C\uD574\uD558\uAE30 \uC9DD\uC774 \uC5C6\uAD70!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 0670a9cd0bb4cbd4d81d887410af3768, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC5B4\uBA38, \uD560\uB9DD\uAD6C \uAE68\uC5B4\uB098\uC168\uC5B4?"
    characterName: "\uB450\uCAC0\uCFE0"
    characterImage: {fileID: 21300000, guid: d0d42416a3040a74d92e1df0901ff45d, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC544\uC9C1\uB3C4 \uB9C8\uCE74\uB871\uC774 \uB514\uC800\uD2B8\uACC4 \uD604\uC5ED\uC778
      \uC904 \uC544\uB294 \uAC70 \uC644\uC804 \uC6C3\uAE30\uB2E4."
    characterName: "\uB450\uCAC0\uCFE0"
    characterImage: {fileID: 21300000, guid: d0d42416a3040a74d92e1df0901ff45d, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uD558, \uD560\uB9DD\uAD6C\uB77C \uD558\uC600\uB290\uB0D0?!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 0670a9cd0bb4cbd4d81d887410af3768, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC5B4\uB9B0 \uAC83\uC774 \uC608\uC758\uB3C4 \uC5C6\uAD6C\uB098!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 0670a9cd0bb4cbd4d81d887410af3768, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uBCF8 \uB9C8\uB140\uB294 \uC655\uC2E4 \uB2E4\uACFC\uD68C\uC5D0\uB3C4
      \uC624\uB978 \uC815\uD1B5 \uB514\uC800\uD2B8\uB780 \uB9D0\uC774\uB2E4!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 23c865355679f424d93d64ffdb23ee04, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC815\uD1B5?"
    characterName: "\uB450\uCAC0\uCFE0"
    characterImage: {fileID: 21300000, guid: 8ba5062473f75fd4ba6f6629a2fb65f0, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uADF8\uAC70 \uC694\uC998 \uB9D0\uB85C \uCCA0 \uC9C0\uB09C \uCF58\uC149\uD2B8
      \uC544\uB2C8\uC57C?"
    characterName: "\uB450\uCAC0\uCFE0"
    characterImage: {fileID: 21300000, guid: 52fd380f94db54d45a90b857eeb2570f, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uB09C \uC9C0\uAE08 \uC2E4\uC2DC\uAC04 \uC778\uAE30 \uAE09\uC0C1\uC2B9\uC774\uB77C\uACE0."
    characterName: "\uB450\uCAC0\uCFE0"
    characterImage: {fileID: 21300000, guid: 8ba5062473f75fd4ba6f6629a2fb65f0, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC720\uD589\uC774\uB780 \uC124\uD0D5\uAC00\uB8E8\uCC98\uB7FC \uD6C5 \uB0A0\uC544\uAC00\uB294
      \uBC95\uC774\uB2E4!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 23c865355679f424d93d64ffdb23ee04, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uBC18\uC9DD\uAC70\uB9B0\uB2E4\uACE0 \uB2E4 \uACE0\uAE09\uC778 \uC904
      \uC544\uB290\uB0D0?"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 23c865355679f424d93d64ffdb23ee04, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uCBE7, \uC774\uB798\uC11C \uC694\uC998 \uAC83\uB4E4\uC740..."
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: eb879457fcc3a344b907bbfca84a4b72, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "...\uD765. \uADF8\uB7F0 \uB9D0, \uC9C4\uC9DC \uC2EB\uAC70\uB4E0."
    characterName: "\uB450\uCAC0\uCFE0"
    characterImage: {fileID: 21300000, guid: c0425f50fdf2b1044ab1d468519bd79e, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uADF8\uB798\uB3C4 \uB098\uD55C\uD14C \uAD00\uC2EC\uC740 \uC0DD\uACBC\uC9C0?"
    characterName: "\uB450\uCAC0\uCFE0"
    characterImage: {fileID: 21300000, guid: 8ba5062473f75fd4ba6f6629a2fb65f0, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uADF8\uB7FC \uB530\uB77C\uC640 \uBD10!"
    characterName: "\uB450\uCAC0\uCFE0"
    characterImage: {fileID: 21300000, guid: 8ba5062473f75fd4ba6f6629a2fb65f0, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uB450\uCAC0\uCFE0\uB294 \uBC18\uC9DD\uC774\uB294 \uCE74\uBA54\uB77C \uC870\uBA85
      \uC0AC\uC774\uB85C \uC3D9 \uB3C4\uB9DD\uCCE4\uB2E4."
    characterName: 
    characterImage: {fileID: 0}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC800 \uADFC\uBCF8 \uC5C6\uB294 \uCFE0\uD0A4 \uC870\uAC01\uC774!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 0670a9cd0bb4cbd4d81d887410af3768, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uAC70\uAE30 \uC11C\uB77C!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 0670a9cd0bb4cbd4d81d887410af3768, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  dialogueLines: []

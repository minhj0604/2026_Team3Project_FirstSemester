MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b7d8a690fa834739a393e1d62072b901, type: 3}
  m_Name: Chapter1_Stage1
  m_EditorClassIdentifier: 
  characterName: "\uB9C8\uCE74\uB871"
  characterImage: {fileID: 21300000, guid: eb879457fcc3a344b907bbfca84a4b72, type: 3}
  useDefaultBackground: 1
  defaultBackgroundImage: {fileID: 0}
  defaultBackgroundColor: {r: 0, g: 0, b: 0, a: 0}
  entries:
  - text: "\uB450\uCAC0\uCFE0\uC758 \uBC18\uC9DD\uC774\uB97C \uCAD3\uB358 \uB9C8\uCE74\uB871
      \uC55E\uC5D0..."
    characterName: 
    characterImage: {fileID: 0}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC694\uAC70\uD2B8 \uC544\uC774\uC2A4\uD06C\uB9BC \uC2AC\uB77C\uC784\uB4E4\uC774
      \uAE38\uC744 \uB9C9\uC544\uC130\uB2E4."
    characterName: 
    characterImage: {fileID: 0}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC73C\uC5D1, \uC774 \uC7A1\uD0D5\uC740 \uBB50\uB0D0!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 23c865355679f424d93d64ffdb23ee04, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uBE44\uCF1C\uB77C, \uB9D0\uB791\uD55C \uAC83\uB4E4\uC544!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 0670a9cd0bb4cbd4d81d887410af3768, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uBCF8 \uB9C8\uB140\uB294 \uC9C0\uAE08 \uC544\uC8FC \uBC14\uC058\uB2E8
      \uB9D0\uC774\uB2E4!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 23c865355679f424d93d64ffdb23ee04, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC2AC\uB77C\uC784\uB4E4\uC740 \uB9D0\uC5C6\uC774 \uC0C9\uC744 \uBC14\uAFB8\uBA70
      \uD1B5\uD1B5 \uD280\uC5C8\uB2E4."
    characterName: 
    characterImage: {fileID: 0}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uB300\uB2F5\uB3C4 \uC548 \uD558\uB290\uB0D0?"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 0670a9cd0bb4cbd4d81d887410af3768, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC5B4\uB978\uC774 \uB9D0\uD558\uBA74 \uB300\uB2F5\uD574\uC57C\uC9C0!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 0670a9cd0bb4cbd4d81d887410af3768, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  - text: "\uC88B\uB2E4. \uC624\uB798\uB41C \uB514\uC800\uD2B8\uC758 \uBB34\uC11C\uC6C0\uC744
      \uCF55\uCF55 \uBC15\uC544\uC8FC\uB9C8!"
    characterName: "\uB9C8\uCE74\uB871 \uB9C8\uB140"
    characterImage: {fileID: 21300000, guid: 23c865355679f424d93d64ffdb23ee04, type: 3}
    changeBackground: 0
    backgroundImage: {fileID: 0}
    backgroundColor: {r: 0, g: 0, b: 0, a: 0}
  dialogueLines: []
